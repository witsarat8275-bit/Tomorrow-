      // =========================================================================
      // 6. การควบคุมเวลา (10 นาที)
      // =========================================================================
      function formatTime(sec) {
        const m = Math.floor(sec / 60);
        const s = sec % 60;
        return `${String(m).padStart(2, "0")}:${String(s).padStart(2, "0")}`;
      }

      function stopTimer() {
        if (state.timerId !== null) {
          clearInterval(state.timerId);
          state.timerId = null;
        }
      }

      function startTimer() {
        stopTimer();
        state.secondsLeft = 600;
        timerDisplay.classList.remove("urgent");
        timerDisplay.textContent = `เวลาที่เหลือ ${formatTime(state.secondsLeft)}`;

        state.timerId = setInterval(() => {
          state.secondsLeft -= 1;
          if (state.secondsLeft <= 60) {
            timerDisplay.classList.add("urgent");
          }
          if (state.secondsLeft <= 0) {
            state.secondsLeft = 0;
            timerDisplay.textContent = "หมดเวลา 00:00";
            stopTimer();
            finalizeQuiz(true);
            return;
          }
          timerDisplay.textContent = `เวลาที่เหลือ ${formatTime(state.secondsLeft)}`;
        }, 1000);
      }

      // =========================================================================
      // 7. การเริ่มต้นและเรนเดอร์โจทย์ (ใช้ textContent ป้องกัน XSS)
      // =========================================================================
      function showError(el, msg) {
        el.textContent = msg;
        el.classList.remove("hidden");
      }

      function hideError(el) {
        el.textContent = "";
        el.classList.add("hidden");
      }

      function beginActivity(studentNo) {
        state.studentNo = studentNo;
        state.exam = generateStudentExam(studentNo);
        state.currentIdx = 0;
        state.answers = new Array(state.exam.length).fill(null);
        state.submitted = false;

        hideError(startErrorMsg);
        hideError(quizWarnMsg);

        startSection.classList.add("hidden");
        resultSection.classList.add("hidden");
        quizSection.classList.remove("hidden");

        studentBadge.textContent = `นักเรียนเลขที่ ${studentNo}`;
        startTimer();
        renderQuestion();
        safeSaveProgress();
      }

      function renderNavDots() {
        qNavDots.textContent = "";
        state.exam.forEach((q, idx) => {
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = "q-dot";
          if (idx === state.currentIdx) btn.classList.add("active");
          if (state.answers[idx] !== null) btn.classList.add("answered");
          btn.textContent = String(idx + 1);
          btn.setAttribute("aria-label", `ไปยังข้อที่ ${idx + 1}`);
          btn.addEventListener("click", () => {
            hideError(quizWarnMsg);
            state.currentIdx = idx;
            renderQuestion();
          });
          qNavDots.appendChild(btn);
        });
      }

      function renderInstantFeedback(q, selectedOptIdx) {
        if (selectedOptIdx === null) {
          instantFeedbackBox.classList.add("hidden");
          instantFeedbackBox.textContent = "";
          return;
        }

        const isRight = selectedOptIdx === q.correctIndex;
        instantFeedbackBox.classList.remove("hidden");
        instantFeedbackBox.classList.toggle("needs-review", !isRight);
        instantFeedbackBox.textContent = "";

        const titleEl = document.createElement("div");
        titleEl.style.fontWeight = "700";
        titleEl.style.marginBottom = "4px";
        titleEl.style.color = isRight ? "#15803d" : "#b45309";
        titleEl.textContent = isRight
          ? "เยี่ยมมาก! นักเรียนเลือกแนวทางที่ปลอดภัยและเหมาะสม"
          : "ลองทบทวนมุมมองด้านสุขภาพเพิ่มเติมนะ (สามารถเปลี่ยนคำตอบได้ในโหมดฝึกซ้อม)";

        const expEl = document.createElement("div");
        expEl.textContent = `เหตุผลทางสุขศึกษา: ${q.explanation}`;

        instantFeedbackBox.appendChild(titleEl);
        instantFeedbackBox.appendChild(expEl);
      }

      function renderQuestion() {
        const q = state.exam[state.currentIdx];
        const total = state.exam.length;

        diffBadge.textContent = q.difficultyLabel;
        progressFill.style.width = `${((state.currentIdx + 1) / total) * 100}%`;
        topicTag.textContent = `ข้อที่ ${q.qNumber} จาก ${total} • ${q.topic}`;
        scenarioText.textContent = `สถานการณ์: ${q.scenario}`;
        questionStem.textContent = q.stem;

        renderNavDots();

        optionsContainer.textContent = "";
        const selectedOpt = state.answers[state.currentIdx];

        q.options.forEach((opt, optIdx) => {
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = "option-item";
          if (selectedOpt === optIdx) {
            btn.classList.add("selected");
          }

          const letterSpan = document.createElement("span");
          letterSpan.className = "option-letter";
          letterSpan.textContent = opt.letter;

          const textSpan = document.createElement("span");
          textSpan.textContent = opt.text;

          btn.appendChild(letterSpan);
          btn.appendChild(textSpan);

          btn.addEventListener("click", () => {
            hideError(quizWarnMsg);
            state.answers[state.currentIdx] = optIdx;
            safeSaveProgress();
            renderQuestion();
          });

          optionsContainer.appendChild(btn);
        });

        renderInstantFeedback(q, selectedOpt);

        prevBtn.disabled = state.currentIdx === 0;
        if (state.currentIdx === total - 1) {
          nextBtn.classList.add("hidden");
          submitBtn.classList.remove("hidden");
        } else {
          nextBtn.classList.remove("hidden");
          submitBtn.classList.add("hidden");
        }
      }

      // =========================================================================
      // 8. ตรวจคำตอบและแสดงหน้าสรุปผล + Rubric
      // =========================================================================
      function finalizeQuiz(isTimeOut) {
        if (!isTimeOut) {
          const unansweredIdx = state.answers.findIndex((a) => a === null);
          if (unansweredIdx !== -1) {
            showError(
              quizWarnMsg,
              `นักเรียนยังไม่ได้เลือกคำตอบในข้อที่ ${unansweredIdx + 1} กรุณาตอบให้ครบทั้ง 5 ข้อก่อนกดส่งนะครับ`
            );
            state.currentIdx = unansweredIdx;
            renderQuestion();
            return;
          }
        }

        stopTimer();
        state.submitted = true;
        safeSaveProgress();

        let score = 0;
        state.exam.forEach((q, idx) => {
          if (state.answers[idx] === q.correctIndex) {
            score += 1;
          }
        });

        quizSection.classList.add("hidden");
        resultSection.classList.remove("hidden");

        resultStudentLabel.textContent = `ผลการฝึกทักษะ • นักเรียนเลขที่ ${state.studentNo}${isTimeOut ? " (หมดเวลาทำกิจกรรม)" : ""}`;
        scoreDisplay.textContent = `${score} / ${state.exam.length} คะแนน`;

        if (score === 5) {
          encouragementText.textContent = "ยอดเยี่ยมมาก! นักเรียนตัดสินใจดูแลสุขภาพ ปฏิเสธความเสี่ยง และรู้เท่าทันสื่อได้อย่างรอบคอบครบทุกข้อ";
        } else if (score >= 3) {
          encouragementText.textContent = "ทำได้ดีมาก! นักเรียนเข้าใจหลักการดูแลสุขภาพส่วนใหญ่แล้ว ลองอ่านคำอธิบายเพิ่มเติมในข้อที่ยังคลาดเคลื่อนเพื่อพัฒนาต่อนะ";
        } else {
          encouragementText.textContent = "เป็นการเริ่มต้นฝึกฝนที่ดีมาก! การเรียนรู้เรื่องสุขภาพต้องอาศัยการฝึกคิดวิเคราะห์ ลองอ่านเฉลยด้านล่างแล้วกดลองทำใหม่อีกครั้งได้เลย";
        }

        renderReviewCards();
      }

      function renderReviewCards() {
        reviewContainer.textContent = "";
        state.exam.forEach((q, idx) => {
          const userAnsIdx = state.answers[idx];
          const isCorrect = userAnsIdx === q.correctIndex;
          const correctOpt = q.options[q.correctIndex];
          const userOpt = userAnsIdx !== null ? q.options[userAnsIdx] : null;

          const card = document.createElement("div");
          card.className = "review-card";

          const headerRow = document.createElement("div");
          headerRow.style.display = "flex";
          headerRow.style.justifyContent = "space-between";
          headerRow.style.alignItems = "center";
          headerRow.style.marginBottom = "8px";
          headerRow.style.flexWrap = "wrap";
          headerRow.style.gap = "6px";

          const qTitle = document.createElement("strong");
          qTitle.textContent = `ข้อที่ ${q.qNumber} (${q.difficultyLabel})`;

          const statusTag = document.createElement("span");
          statusTag.className = "badge";
          statusTag.style.background = isCorrect ? "var(--success-bg)" : "var(--warn-bg)";
          statusTag.style.color = isCorrect ? "#15803d" : "#b45309";
          statusTag.textContent = isCorrect ? "ตอบถูกต้อง" : "ควรทบทวนเพิ่มเติม";

          headerRow.appendChild(qTitle);
          headerRow.appendChild(statusTag);

          const scenP = document.createElement("p");
          scenP.style.fontSize = "0.93rem";
          scenP.style.color = "#334155";
          scenP.style.marginBottom = "6px";
          scenP.textContent = `สถานการณ์: ${q.scenario}`;

          const stemP = document.createElement("p");
          stemP.style.fontWeight = "600";
          stemP.style.marginBottom = "8px";
          stemP.textContent = `คำถาม: ${q.stem}`;

          const userChoiceP = document.createElement("p");
          userChoiceP.style.fontSize = "0.92rem";
          userChoiceP.style.marginBottom = "4px";
          userChoiceP.style.color = isCorrect ? "#15803d" : "#b91c1c";
          userChoiceP.textContent = userOpt
            ? `คำตอบที่นักเรียนเลือก: (${userOpt.letter}) ${userOpt.text}`
            : "คำตอบที่นักเรียนเลือก: ไม่ได้เลือกคำตอบ";

          const correctChoiceP = document.createElement("p");
          correctChoiceP.style.fontSize = "0.92rem";
          correctChoiceP.style.fontWeight = "600";
          correctChoiceP.style.color = "#15803d";
          correctChoiceP.style.marginBottom = "8px";
          correctChoiceP.textContent = `เฉลยที่เหมาะสมที่สุด: (${correctOpt.letter}) ${correctOpt.text}`;

          const expP = document.createElement("p");
          expP.style.fontSize = "0.92rem";
          expP.style.color = "#1e293b";
          expP.textContent = `คำอธิบายเหตุผล: ${q.explanation}`;

          const rubricDiv = document.createElement("div");
          rubricDiv.className = "rubric-box";
          rubricDiv.textContent = q.rubric;

          card.appendChild(headerRow);
          card.appendChild(scenP);
          card.appendChild(stemP);
          card.appendChild(userChoiceP);
          card.appendChild(correctChoiceP);
          card.appendChild(expP);
          card.appendChild(rubricDiv);

          reviewContainer.appendChild(card);
        });
      }

      // =========================================================================
      // 9. โหมดครู (Teacher Inspection Modal)
      // =========================================================================
      function renderTeacherPreview(studentNo) {
        teacherPreviewContainer.textContent = "";
        const num = Number(studentNo);
        if (!Number.isInteger(num) || num < 1 || num > 11) {
          const err = document.createElement("div");
          err.className = "alert-msg";
          err.textContent = "กรุณาระบุเลขที่นักเรียนระหว่าง 1 ถึง 11 เท่านั้น";
          teacherPreviewContainer.appendChild(err);
          return;
        }

        const exam = generateStudentExam(num);
        const heading = document.createElement("div");
        heading.style.fontWeight = "700";
        heading.style.marginBottom = "12px";
        heading.style.color = "var(--primary-dark)";
        heading.textContent = `ชุดโจทย์และเฉลยสำหรับนักเรียนเลขที่ ${num} (Seed คงที่ เปิดซ้ำได้ชุดเดิม 100%)`;
        teacherPreviewContainer.appendChild(heading);

        exam.forEach((q) => {
          const box = document.createElement("div");
          box.className = "review-card";
          box.style.marginBottom = "12px";

          const top = document.createElement("div");
          top.style.fontWeight = "700";
          top.style.marginBottom = "4px";
          top.textContent = `ข้อ ${q.qNumber} [${q.difficultyLabel}] • กรณีศึกษาชุดที่ ${q.caseIndex + 1}/4`;

          const scen = document.createElement("div");
          scen.style.fontSize = "0.9rem";
          scen.style.marginBottom = "4px";
          scen.textContent = `สถานการณ์: ${q.scenario}`;

          const stem = document.createElement("div");
          stem.style.fontWeight = "600";
          stem.style.fontSize = "0.92rem";
          stem.style.marginBottom = "6px";
          stem.textContent = `คำถาม: ${q.stem}`;

          const optList = document.createElement("ul");
          optList.style.paddingLeft = "20px";
          optList.style.fontSize = "0.88rem";
          optList.style.marginBottom = "6px";
          q.options.forEach((o) => {
            const li = document.createElement("li");
            li.textContent = `(${o.letter}) ${o.text}${o.isCorrect ? "  [✓ เฉลย]" : ""}`;
            if (o.isCorrect) {
              li.style.fontWeight = "700";
              li.style.color = "#15803d";
            }
            optList.appendChild(li);
          });

          const exp = document.createElement("div");
          exp.style.fontSize = "0.86rem";
          exp.style.color = "#334155";
          exp.textContent = `เหตุผล: ${q.explanation}`;

          const rub = document.createElement("div");
          rub.className = "rubric-box";
          rub.textContent = q.rubric;

          box.appendChild(top);
          box.appendChild(scen);
          box.appendChild(stem);
          box.appendChild(optList);
          box.appendChild(exp);
          box.appendChild(rub);
          teacherPreviewContainer.appendChild(box);
        });
      }

      // =========================================================================
      // 10. Event Listeners
      // =========================================================================
      startQuizBtn.addEventListener("click", () => {
        const rawVal = studentNoInput.value.trim();
        const num = Number(rawVal);
        if (!rawVal || !Number.isInteger(num) || num < 1 || num > 11) {
          showError(startErrorMsg, "กรุณากรอกเลขที่นักเรียนเป็นตัวเลขจำนวนเต็มตั้งแต่ 1 ถึง 11 นะครับ");
          studentNoInput.focus();
          return;
        }
        beginActivity(num);
      });

      studentNoInput.addEventListener("keydown", (e) => {
        if (e.key === "Enter") {
          startQuizBtn.click();
        }
      });

      prevBtn.addEventListener("click", () => {
        if (state.currentIdx > 0) {
          hideError(quizWarnMsg);
          state.currentIdx -= 1;
          renderQuestion();
        }
      });

      nextBtn.addEventListener("click", () => {
        if (state.currentIdx < state.exam.length - 1) {
          hideError(quizWarnMsg);
          state.currentIdx += 1;
          renderQuestion();
        }
      });

      submitBtn.addEventListener("click", () => {
        finalizeQuiz(false);
      });

      retryBtn.addEventListener("click", () => {
        if (state.studentNo) {
          beginActivity(state.studentNo);
        }
      });

      changeStudentBtn.addEventListener("click", () => {
        stopTimer();
        resultSection.classList.add("hidden");
        quizSection.classList.add("hidden");
        startSection.classList.remove("hidden");
        studentNoInput.value = "";
        hideError(startErrorMsg);
        studentNoInput.focus();
      });

      openTeacherBtn.addEventListener("click", () => {
        uniquenessStat.textContent = calculateUniquenessSummary();
        const defaultNo = state.studentNo || 1;
        teacherStudentSelect.value = String(defaultNo);
        renderTeacherPreview(defaultNo);
        teacherModal.classList.remove("hidden");
      });

      closeTeacherBtn.addEventListener("click", () => {
        teacherModal.classList.add("hidden");
      });

      teacherModal.addEventListener("click", (e) => {
        if (e.target === teacherModal) {
          teacherModal.classList.add("hidden");
        }
      });

      teacherInspectBtn.addEventListener("click", () => {
        renderTeacherPreview(teacherStudentSelect.value);
      });

      teacherStudentSelect.addEventListener("change", () => {
        renderTeacherPreview(teacherStudentSelect.value);
      });
    })();
  </script>
</body>
</html>
