<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>สุขศึกษา ป.4 | การตัดสินใจสุขภาพและการรู้เท่าทันสื่อ</title>
  <style>
    :root {
      --primary: #0d9488;
      --primary-dark: #0f766e;
      --primary-light: #ccfbf1;
      --secondary: #0284c7;
      --accent: #f59e0b;
      --bg: #f0fdfa;
      --card: #ffffff;
      --text: #1e293b;
      --muted: #64748b;
      --border: #cbd5e1;
      --success: #16a34a;
      --success-bg: #dcfce7;
      --danger: #dc2626;
      --danger-bg: #fee2e2;
      --warn-bg: #fef3c7;
      --shadow: 0 4px 16px rgba(15, 118, 110, 0.08);
      --radius: 14px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Noto Sans Thai", "Sarabun", Tahoma, sans-serif;
      background: linear-gradient(135deg, #f0fdfa 0%, #e0f2fe 100%);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      line-height: 1.6;
    }

    header {
      background: var(--card);
      border-bottom: 2px solid var(--primary-light);
      padding: 12px 20px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
      position: sticky;
      top: 0;
      z-index: 20;
    }

    .header-inner {
      max-width: 880px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .brand-icon {
      width: 40px;
      height: 40px;
      border-radius: 10px;
      background: var(--primary);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 18px;
      flex-shrink: 0;
    }

    .brand-title {
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--primary-dark);
    }

    .brand-sub {
      font-size: 0.8rem;
      color: var(--muted);
    }

    .btn {
      border: none;
      border-radius: 10px;
      padding: 10px 18px;
      font-size: 0.95rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.18s ease;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      font-family: inherit;
    }

    .btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    .btn-primary {
      background: var(--primary);
      color: #fff;
    }

    .btn-primary:hover:not(:disabled) {
      background: var(--primary-dark);
      transform: translateY(-1px);
    }

    .btn-secondary {
      background: #e2e8f0;
      color: var(--text);
    }

    .btn-secondary:hover:not(:disabled) {
      background: #cbd5e1;
    }

    .btn-teacher {
      background: #f8fafc;
      color: var(--secondary);
      border: 1.5px solid #bae6fd;
      padding: 8px 14px;
      font-size: 0.88rem;
    }

    .btn-teacher:hover {
      background: #e0f2fe;
    }

    main {
      flex: 1;
      width: 100%;
      max-width: 880px;
      margin: 24px auto;
      padding: 0 16px;
    }

    .card {
      background: var(--card);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: 24px;
      margin-bottom: 20px;
      border: 1px solid rgba(203, 213, 225, 0.6);
    }

    .hidden {
      display: none !important;
    }

    .badge {
      display: inline-block;
      padding: 4px 10px;
      border-radius: 999px;
      font-size: 0.78rem;
      font-weight: 600;
      background: var(--primary-light);
      color: var(--primary-dark);
    }

    .badge-diff {
      background: #fef3c7;
      color: #b45309;
    }

    .intro-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 12px;
      margin: 18px 0;
    }

    .info-box {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 10px;
      padding: 12px;
    }

    .info-box-label {
      font-size: 0.78rem;
      color: var(--muted);
    }

    .info-box-val {
      font-weight: 700;
      font-size: 0.95rem;
      color: var(--text);
      margin-top: 2px;
    }

    .form-group {
      margin: 20px 0 12px;
      max-width: 340px;
    }

    label {
      display: block;
      font-weight: 600;
      margin-bottom: 6px;
      font-size: 0.95rem;
    }

    input[type="number"] {
      width: 100%;
      padding: 12px 14px;
      border: 2px solid var(--border);
      border-radius: 10px;
      font-size: 1.05rem;
      font-family: inherit;
      transition: border-color 0.2s;
    }

    input[type="number"]:focus {
      outline: none;
      border-color: var(--primary);
    }

    .alert-msg {
      padding: 10px 14px;
      border-radius: 10px;
      font-size: 0.9rem;
      margin-top: 10px;
      background: var(--danger-bg);
      color: var(--danger);
      border: 1px solid #fecaca;
    }

    .alert-info {
      background: #e0f2fe;
      color: #0369a1;
      border: 1px solid #bae6fd;
    }

    /* Quiz Top Bar */
    .quiz-status-bar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 14px;
    }

    .timer-pill {
      background: #fef3c7;
      color: #92400e;
      font-weight: 700;
      padding: 6px 14px;
      border-radius: 999px;
      font-size: 0.92rem;
      border: 1px solid #fde68a;
    }

    .timer-pill.urgent {
      background: var(--danger-bg);
      color: var(--danger);
      border-color: #fecaca;
    }

    .progress-wrap {
      width: 100%;
      height: 10px;
      background: #e2e8f0;
      border-radius: 999px;
      overflow: hidden;
      margin-bottom: 18px;
    }

    .progress-fill {
      height: 100%;
      background: linear-gradient(90deg, var(--primary), var(--secondary));
      width: 20%;
      transition: width 0.3s ease;
    }

    .q-nav-dots {
      display: flex;
      gap: 8px;
      margin-bottom: 18px;
      flex-wrap: wrap;
    }

    .q-dot {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      border: 2px solid var(--border);
      background: #fff;
      font-weight: 700;
      cursor: pointer;
      color: var(--text);
      transition: all 0.15s;
    }

    .q-dot.active {
      border-color: var(--primary);
      background: var(--primary);
      color: #fff;
    }

    .q-dot.answered:not(.active) {
      border-color: var(--primary);
      background: var(--primary-light);
      color: var(--primary-dark);
    }

    .scenario-box {
      background: #f8fafc;
      border-left: 4px solid var(--primary);
      padding: 16px;
      border-radius: 0 10px 10px 0;
      margin: 14px 0;
      font-size: 1.02rem;
    }

    .question-stem {
      font-weight: 700;
      font-size: 1.08rem;
      margin: 14px 0;
      color: #0f172a;
    }

    .options-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .option-item {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      padding: 14px 16px;
      border: 2px solid #e2e8f0;
      border-radius: 12px;
      cursor: pointer;
      transition: all 0.15s ease;
      background: #fff;
      text-align: left;
      width: 100%;
      font-family: inherit;
      font-size: 0.98rem;
      color: var(--text);
    }

    .option-item:hover:not(:disabled) {
      border-color: var(--primary);
      background: #f0fdfa;
    }

    .option-item.selected {
      border-color: var(--primary);
      background: var(--primary-light);
      font-weight: 600;
    }

    .option-item.correct-show {
      border-color: var(--success);
      background: var(--success-bg);
      color: #14532d;
    }

    .option-item.wrong-show {
      border-color: var(--danger);
      background: var(--danger-bg);
      color: #7f1d1d;
    }

    .option-letter {
      width: 30px;
      height: 30px;
      border-radius: 8px;
      background: #e2e8f0;
      color: var(--text);
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .option-item.selected .option-letter {
      background: var(--primary);
      color: #fff;
    }

    .instant-feedback {
      margin-top: 16px;
      padding: 14px 16px;
      border-radius: 10px;
      background: #f0fdf4;
      border: 1px solid #bbf7d0;
      font-size: 0.94rem;
    }

    .instant-feedback.needs-review {
      background: #fffbeb;
      border-color: #fde68a;
    }

    .quiz-actions {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 22px;
      gap: 12px;
      flex-wrap: wrap;
    }

    /* Results */
    .score-hero {
      text-align: center;
      padding: 20px;
      background: linear-gradient(135deg, #ccfbf1 0%, #e0f2fe 100%);
      border-radius: 12px;
      margin-bottom: 20px;
    }

    .score-num {
      font-size: 2.5rem;
      font-weight: 800;
      color: var(--primary-dark);
    }

    .review-card {
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      padding: 16px;
      margin-bottom: 14px;
      background: #fff;
    }

    .rubric-box {
      margin-top: 10px;
      padding: 10px 12px;
      background: #f8fafc;
      border-radius: 8px;
      border-left: 3px solid var(--secondary);
      font-size: 0.88rem;
      color: #334155;
    }

    /* Modal */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.55);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 16px;
      z-index: 50;
    }

    .modal-box {
      background: #fff;
      border-radius: 16px;
      max-width: 780px;
      width: 100%;
      max-height: 88vh;
      display: flex;
      flex-direction: column;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
      overflow: hidden;
    }

    .modal-header {
      padding: 16px 20px;
      border-bottom: 1px solid #e2e8f0;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: #f8fafc;
    }

    .modal-body {
      padding: 20px;
      overflow-y: auto;
    }

    .teacher-controls {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      align-items: flex-end;
      margin-bottom: 16px;
      padding-bottom: 16px;
      border-bottom: 1px solid #e2e8f0;
    }

    .stat-pill {
      background: #f1f5f9;
      padding: 8px 12px;
      border-radius: 8px;
      font-size: 0.85rem;
      color: #334155;
    }

    footer {
      text-align: center;
      padding: 18px 16px;
      font-size: 0.85rem;
      color: var(--muted);
      border-top: 1px solid #e2e8f0;
      background: rgba(255, 255, 255, 0.75);
      margin-top: auto;
    }

    @media (max-width: 600px) {
      .card {
        padding: 18px;
      }
      .score-num {
        font-size: 2rem;
      }
    }
  </style>
</head>
<body>
  <header>
    <div class="header-inner">
      <div class="brand">
        <div class="brand-icon" aria-hidden="true">สข</div>
        <div>
          <div class="brand-title">สุขศึกษา ป.4 | การตัดสินใจสุขภาพและการรู้เท่าทันสื่อ</div>
          <div class="brand-sub">ผู้สร้าง: Boyban | โรงเรียน: ยปป</div>
        </div>
      </div>
      <button type="button" id="openTeacherBtn" class="btn btn-teacher">โหมดครู</button>
    </div>
  </header>

  <main>
    <!-- หน้าแรก: รับเลขที่นักเรียน -->
    <section id="startSection" class="card">
      <span class="badge">กลุ่มสาระการเรียนรู้สุขศึกษาและพลศึกษา • ชั้นประถมศึกษาปีที่ 4</span>
      <h1 style="font-size: 1.45rem; margin: 10px 0 8px; color: #0f172a;">
        กิจกรรมฝึกทักษะ: เลือกอย่างฉลาด ปลอดภัย และรู้เท่าทันโฆษณา
      </h1>
      <p style="color: var(--muted); font-size: 0.96rem;">
        ฝึกประเมินความเสี่ยงจากสถานการณ์ใกล้ตัว เลือกแนวทางดูแลสุขภาพที่ปลอดภัยเหมาะสมกับวัย และเรียนรู้เหตุผลสนับสนุนการตัดสินใจอย่างสร้างสรรค์
      </p>

      <div class="intro-grid">
        <div class="info-box">
          <div class="info-box-label">รูปแบบกิจกรรม</div>
          <div class="info-box-val">ปรนัย 4 ตัวเลือก (5 ข้อ)</div>
        </div>
        <div class="info-box">
          <div class="info-box-label">เวลาแนะนำ</div>
          <div class="info-box-val">10 นาที (ไล่ระดับง่ายไปยาก)</div>
        </div>
        <div class="info-box">
          <div class="info-box-label">โหมดการเรียนรู้</div>
          <div class="info-box-val">โหมดฝึกซ้อม (ทำซ้ำได้ พร้อมเฉลย)</div>
        </div>
      </div>

      <div class="form-group">
        <label for="studentNoInput">กรอกเลขที่ของนักเรียน (เลขที่ 1 – 11)</label>
        <input type="number" id="studentNoInput" min="1" max="11" placeholder="ระบุเลขที่ เช่น 1 ถึง 11" />
        <div id="startErrorMsg" class="alert-msg hidden" role="alert"></div>
      </div>

      <div style="display: flex; gap: 10px; flex-wrap: wrap; margin-top: 14px;">
        <button type="button" id="startQuizBtn" class="btn btn-primary">เริ่มทำกิจกรรม</button>
      </div>
    </section>

    <!-- หน้าทำแบบฝึกหัด -->
    <section id="quizSection" class="card hidden">
      <div class="quiz-status-bar">
        <div>
          <span class="badge" id="studentBadge">นักเรียนเลขที่ -</span>
          <span class="badge badge-diff" id="diffBadge" style="margin-left: 6px;">ระดับความยาก 1/5</span>
        </div>
        <div class="timer-pill" id="timerDisplay">เวลาที่เหลือ 10:00</div>
      </div>

      <div class="progress-wrap" aria-label="ความคืบหน้าการทำกิจกรรม">
        <div class="progress-fill" id="progressFill"></div>
      </div>

      <div class="q-nav-dots" id="qNavDots" aria-label="เลือกข้อคำถาม"></div>

      <div>
        <div style="font-size: 0.85rem; color: var(--muted); font-weight: 600;" id="topicTag">หัวข้อย่อย</div>
        <div class="scenario-box" id="scenarioText"></div>
        <div class="question-stem" id="questionStem"></div>
        <div class="options-list" id="optionsContainer"></div>

        <!-- แสดงคำอธิบายเหตุผลทันทีหลังเลือกตอบ -->
        <div id="instantFeedbackBox" class="instant-feedback hidden"></div>
      </div>

      <div id="quizWarnMsg" class="alert-msg hidden" role="alert"></div>

      <div class="quiz-actions">
        <button type="button" id="prevBtn" class="btn btn-secondary">← ข้อก่อนหน้า</button>
        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
          <button type="button" id="nextBtn" class="btn btn-primary">ข้อถัดไป →</button>
          <button type="button" id="submitBtn" class="btn btn-primary hidden">ตรวจ/ส่งคำตอบ</button>
        </div>
      </div>
    </section>

    <!-- หน้าสรุปผลและเฉลย -->
    <section id="resultSection" class="card hidden">
      <div class="score-hero">
        <div style="font-size: 0.92rem; font-weight: 600; color: var(--primary-dark);" id="resultStudentLabel">ผลการฝึกทักษะ</div>
        <div class="score-num" id="scoreDisplay">0 / 5 คะแนน</div>
        <p id="encouragementText" style="margin-top: 6px; font-weight: 500; color: #1e293b;"></p>
      </div>

      <h2 style="font-size: 1.15rem; margin-bottom: 12px; color: #0f172a;">เฉลยละเอียด คำอธิบาย และเกณฑ์เหตุผล (Rubric)</h2>
      <div id="reviewContainer"></div>

      <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-top: 20px;">
        <button type="button" id="retryBtn" class="btn btn-primary">ลองทำใหม่อีกครั้ง (เลขที่เดิม)</button>
        <button type="button" id="changeStudentBtn" class="btn btn-secondary">เปลี่ยนเลขที่นักเรียน</button>
      </div>
    </section>
  </main>

  <!-- Modal โหมดครู -->
  <div id="teacherModal" class="modal-backdrop hidden" role="dialog" aria-modal="true" aria-labelledby="teacherModalTitle">
    <div class="modal-box">
      <div class="modal-header">
        <div>
          <h2 id="teacherModalTitle" style="font-size: 1.1rem; color: #0f172a;">โหมดครู: ตรวจสอบชุดโจทย์และเฉลยรายเลขที่</h2>
          <div style="font-size: 0.8rem; color: var(--muted);">Strategy C (Case-Based Variation) • Deterministic Seed (เลขที่ 1–11)</div>
        </div>
        <button type="button" id="closeTeacherBtn" class="btn btn-secondary" style="padding: 6px 12px;">ปิดหน้าต่าง</button>
      </div>
      <div class="modal-body">
        <div class="alert-msg alert-info" style="margin-top: 0; margin-bottom: 14px;">
          หมายเหตุ: เว็บแอปแบบทำงานฝั่งเบราว์เซอร์ (Client-Side) ไม่สามารถซ่อนข้อมูลเฉลยจากโค้ดเบราว์เซอร์ได้ 100% โปรดตรวจสอบความถูกต้องของโจทย์และเฉลยก่อนนำไปใช้จริงในชั้นเรียน
        </div>

        <div class="teacher-controls">
          <div>
            <label for="teacherStudentSelect" style="font-size: 0.88rem;">เลือกเลขที่นักเรียน (1–11)</label>
            <input type="number" id="teacherStudentSelect" min="1" max="11" value="1" style="width: 130px; padding: 8px 12px;" />
          </div>
          <button type="button" id="teacherInspectBtn" class="btn btn-primary" style="padding: 9px 16px;">แสดงโจทย์และเฉลย</button>
          <div class="stat-pill" id="uniquenessStat">กำลังคำนวณอัตราความหลากหลาย...</div>
        </div>

        <div id="teacherPreviewContainer"></div>
      </div>
    </div>
  </div>

  <footer>
    วิชาสุขศึกษา ชั้นประถมศึกษาปีที่ 4 • ผู้สร้าง: Boyban • โรงเรียน: ยปป
  </footer>

  <script>
    (function () {
      "use strict";

      // =========================================================================
      // 1. Deterministic PRNG (Mulberry32) — ไม่มี Math.random() แบบไร้ Seed
      // =========================================================================
      function mulberry32(seed) {
        let t = seed >>> 0;
        return function () {
          t += 0x6D2B79F5;
          let r = Math.imul(t ^ (t >>> 15), 1 | t);
          r ^= r + Math.imul(r ^ (r >>> 7), 61 | r);
          return ((r ^ (r >>> 14)) >>> 0) / 4294967296;
        };
      }

      function computeSeed(studentNo, questionIndex, salt) {
        // ผสมเลขที่นักเรียน หมายเลขข้อ และค่าคงที่ให้กระจายตัวสูงและทำซ้ำได้ 100%
        let h = 2166136261 >>> 0;
        const inputs = [studentNo * 131 + 17, questionIndex * 977 + 31, salt * 3571 + 7];
        for (let i = 0; i < inputs.length; i++) {
          h ^= inputs[i];
          h = Math.imul(h, 16777619) >>> 0;
        }
        return h >>> 0;
      }

      function seededShuffle(array, seed) {
        const rng = mulberry32(seed);
        const copy = array.slice();
        for (let i = copy.length - 1; i > 0; i--) {
          const j = Math.floor(rng() * (i + 1));
          const temp = copy[i];
          copy[i] = copy[j];
          copy[j] = temp;
        }
        return copy;
