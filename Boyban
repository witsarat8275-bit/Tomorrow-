      // =========================================================================
      // 3. ฟังก์ชันสร้างชุดข้อสอบเฉพาะบุคคลตามเลขที่ (1-11)
      // =========================================================================
      function generateStudentExam(studentNo) {
        const letters = ["ก", "ข", "ค", "ง"];
        return QUESTION_BANK.map((qGroup, qIdx) => {
          // เลือกกรณีศึกษา 1 จาก 4 โดยใช้ Seed ของเลขที่ + ข้อ
          const caseSeed = computeSeed(studentNo, qIdx, 101);
          const rng = mulberry32(caseSeed);
          const caseIndex = Math.floor(rng() * qGroup.cases.length);
          const chosenCase = qGroup.cases[caseIndex];

          // สุ่มลำดับตัวเลือก 4 ข้ออย่างกำหนดซ้ำได้เมื่อเปิด Seed เดิม
          const optSeed = computeSeed(studentNo, qIdx, 202);
          const shuffledOptions = seededShuffle(chosenCase.options, optSeed).map((opt, idx) => ({
            letter: letters[idx],
            text: opt.text,
            isCorrect: opt.isCorrect
          }));

          const correctIndex = shuffledOptions.findIndex((o) => o.isCorrect);

          return {
            qNumber: qIdx + 1,
            level: qGroup.level,
            difficultyLabel: qGroup.difficultyLabel,
            topic: qGroup.topic,
            rubric: qGroup.rubric,
            caseIndex: caseIndex,
            scenario: chosenCase.scenario,
            stem: chosenCase.stem,
            options: shuffledOptions,
            correctIndex: correctIndex,
            explanation: chosenCase.explanation
          };
        });
      }

      // คำนวณอัตราความไม่ซ้ำของชุดโจทย์ระหว่างเลขที่ 1-11
      function calculateUniquenessSummary() {
        const signatures = new Set();
        for (let no = 1; no <= 11; no++) {
          const exam = generateStudentExam(no);
          const sig = exam.map((q) => `${q.caseIndex}-${q.correctIndex}`).join("|");
          signatures.add(sig);
        }
        const uniquePct = Math.round((signatures.size / 11) * 100);
        return `ชุดโจทย์เลขที่ 1–11 ไม่ซ้ำกัน ${signatures.size}/11 ชุด (${uniquePct}%)`;
      }

